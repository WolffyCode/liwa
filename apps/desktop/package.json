{
  "name": "@liwa/desktop",
  "description": "Electron desktop shell for a bundled liwa runtime and external plugins",
  "version": "0.2.2-alpha.2",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Hangzhou DeepSeek Artificial Intelligence Co., Ltd."
  },
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc -b && pnpm run bundle",
    "bundle": "tsdown --config-loader native",
    "dev": "tsx scripts/dev.ts",
    "start": "tsx scripts/dev.ts --skip-build",
    "prepare:runtime": "tsx scripts/prepare-runtime.ts",
    "render:tray-icon": "tsx scripts/render-tray-icon.ts",
    "prepare:primary-runtime": "tsx scripts/prepare-primary-runtime.ts",
    "prepare:packages": "tsx scripts/prepare-package-set.ts",
    "prepare:liwa": "tsx scripts/prepare-liwa.ts",
    "prepare:package": "tsx scripts/package-target.ts --prepare-only",
    "package": "tsx scripts/package-target.ts",
    "check:package": "tsx scripts/package-target.ts --check",
    "package:dir": "tsx scripts/package-target.ts --dir"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "@liwa/cordis": "workspace:~"
  },
  "devDependencies": {
    "@liwa/app-boot": "workspace:*",
    "@liwa/client-ui-settings-general": "workspace:*",
    "@liwa/client-ui-sidebar-browser": "workspace:*",
    "@liwa/home-paths": "workspace:*",
    "@liwa/official-bundles": "workspace:*",
    "@liwa/node-addon-system": "workspace:~",
    "@electron/get": "^5.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/semver": "^7.8.0",
    "app-builder-lib": "26.17.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "extract-zip": "^2.0.1",
    "js-yaml": "^4.3.2",
    "koffi": "3.1.1",
    "pnpm": "11.28.5",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^6.4.3",
    "@liwa/client-ui-theme": "workspace:*",
    "@liwa/client-shortcuts": "workspace:*",
    "@liwa/atomic-write": "workspace:*",
    "@liwa/client-product-analytics": "workspace:*",
    "@liwa/plugin-manager": "workspace:*",
    "zod": "4.4.3",
    "@liwa/util-file-drag": "workspace:*"
  }
}
