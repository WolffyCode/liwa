# Copy to production.env and configure the production service before selecting this preset.
LIWA_DESKTOP_APP_ID=com.deepseek.dsh
LIWA_DESKTOP_AUTO_UPDATE_ENV=production
LIWA_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
LIWA_DESKTOP_MACOS_PACK_CONCURRENCY=4
LIWA_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
LIWA_DESKTOP_MACOS_DOWNLOAD_PROXY=
LIWA_DESKTOP_MACOS_NOTARIZATION_PROXY=
# Optional absolute private directory; setup fills this in for machine presets. Omit to use checkout-local storage.
# LIWA_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
