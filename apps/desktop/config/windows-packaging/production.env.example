# Copy to production.env in the same machine configuration directory and fill in the values.
LIWA_DESKTOP_APP_ID=com.deepseek.dsh
LIWA_DESKTOP_AUTO_UPDATE_ENV=production
LIWA_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
LIWA_DESKTOP_MANDATORY_UPDATE_CONFIG='{}'
# LIWA_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
LIWA_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
# Installer archive compression (0-9).
LIWA_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3
