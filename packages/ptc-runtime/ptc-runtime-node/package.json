{
  "name": "@liwa/ptc-runtime-node",
  "description": "Node PTC execution with async function, REPL and VM Script evaluators and optional retained state",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/ptc-runtime/ptc-runtime-node"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./configuration": {
      "types": "./lib/types/configuration.d.ts",
      "default": "./lib/configuration.js"
    },
    "./process": {
      "types": "./lib/types/process-entry.d.ts",
      "default": "./lib/process.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/configuration.js",
    "lib/process.js",
    "lib/persistent-process.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/ptc-runtime": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/timeout": "workspace:*",
    "@liwa/fs": "workspace:*",
    "@liwa/subprocess": "workspace:*",
    "@liwa/sandbox": "workspace:*",
    "@liwa/sandbox-policy": "workspace:*"
  },
  "dependencies": {
    "@liwa/util-values": "workspace:*",
    "@liwa/schemastery": "workspace:~",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "birpc": "4.2.0"
  },
  "devDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/ptc-runtime": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/timeout": "workspace:*",
    "@liwa/fs": "workspace:*",
    "@liwa/subprocess": "workspace:*",
    "@liwa/sandbox": "workspace:*",
    "@liwa/sandbox-policy": "workspace:*",
    "@liwa/fs-local": "workspace:*",
    "@liwa/subprocess-local": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/sandbox-local": "workspace:*"
  }
}
