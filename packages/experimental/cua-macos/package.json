{
  "name": "@liwa/experimental-cua-macos",
  "description": "macOS native provider for shared Computer Use application and window objects",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/experimental/cua-macos"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "native/bin",
    "native/Package.swift",
    "native/Sources",
    "native/tests/swift",
    "native/tests/test_swift.py",
    "native/LICENSE.cua-driver",
    "native/upstream.json",
    "native/README.md",
    "native/README.zh.md",
    "native/protocol.schema.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/computer-use": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/agent": "workspace:*",
    "@liwa/subprocess": "workspace:*",
    "@liwa/user-questions": "workspace:*"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@liwa/atomic-write": "workspace:*",
    "@liwa/cua": "workspace:*"
  },
  "devDependencies": {
    "@liwa/working-directory": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/cordis-plugin-include": "workspace:~",
    "@liwa/cordis-plugin-loader": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/agent-loop": "workspace:*",
    "@liwa/agent-loop-testkit": "workspace:*",
    "@liwa/attachment": "workspace:*",
    "@liwa/attachment-local": "workspace:*",
    "@liwa/computer-use": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/tool-executor-native": "workspace:*",
    "@liwa/tool-executor-ptc": "workspace:*",
    "@liwa/tool-testkit": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/subprocess": "workspace:*",
    "@liwa/subprocess-local": "workspace:*",
    "@liwa/fs-local": "workspace:*",
    "@liwa/llm-deepseek": "workspace:*",
    "@liwa/ptc-runtime-node": "workspace:*",
    "@liwa/sandbox-local": "workspace:*",
    "@liwa/sandbox-policy": "workspace:*",
    "sharp": "^0.35.3",
    "@liwa/ptc-runtime": "workspace:*",
    "@liwa/user-questions": "workspace:*",
    "@liwa/settings": "workspace:*",
    "@liwa/app-boot": "workspace:*",
    "@liwa/config-editor": "workspace:*",
    "@liwa/hmr": "workspace:*",
    "@liwa/cordis-plugin-timer": "workspace:~",
    "@liwa/storage": "workspace:*",
    "@liwa/storage-json": "workspace:*",
    "@liwa/storage-domain": "workspace:*"
  },
  "scripts": {
    "build:native": "swift build --package-path native --configuration release"
  },
  "os": [
    "darwin"
  ]
}
