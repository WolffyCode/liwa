{
  "name": "@liwa/experimental-browser-use-chrome-devtools-mcp",
  "description": "Experimental per-Session Chromium browser tools through chrome-devtools-mcp",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/experimental/browser-use-chrome-devtools-mcp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@liwa/experimental-browser-use-runtime": "workspace:*",
    "chrome-devtools-mcp": "1.9.0"
  },
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/browser-use": "workspace:*",
    "@liwa/agent": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/cordis-plugin-loader": "workspace:~",
    "@liwa/cordis-plugin-include": "workspace:~",
    "@liwa/browser-use": "workspace:*",
    "@liwa/agent": "workspace:*",
    "@liwa/agent-loop": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/working-directory": "workspace:*"
  }
}
