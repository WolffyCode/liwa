{
  "name": "@liwa/webhook",
  "description": "Fire-and-forget webhook rule runtime that creates Workspace-backed Liwa Sessions",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/experimental/webhook"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/agent-default-model": "workspace:*",
    "@liwa/agent-preset-registry": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/permission-presets": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-title": "workspace:*",
    "@liwa/workspace": "workspace:*"
  },
  "devDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/cordis-plugin-include": "workspace:~",
    "@liwa/cordis-plugin-loader": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/agent-default-model": "workspace:*",
    "@liwa/agent-preset-registry": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/permission-presets": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-title": "workspace:*",
    "@liwa/workspace": "workspace:*"
  },
  "dependencies": {
    "@liwa/brand": "workspace:*",
    "@liwa/util-values": "workspace:*"
  }
}
