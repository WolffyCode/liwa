{
  "name": "@liwa/experimental-forge-session",
  "description": "Binds change requests to the Session that created, pushed, or tracked them",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/experimental/forge-session"
  },
  "dependencies": {
    "@liwa/timeout": "workspace:*",
    "@liwa/util-values": "workspace:*",
    "@liwa/schemastery": "workspace:~",
    "shell-quote": "^1.12.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/experimental-forge": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/shell": "workspace:*",
    "@liwa/shell-env": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/sandbox-policy": "workspace:*"
  },
  "devDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/cordis-plugin-include": "workspace:~",
    "@liwa/cordis-plugin-loader": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/agent-loop": "workspace:*",
    "@liwa/bash-local": "workspace:*",
    "@liwa/experimental-forge": "workspace:*",
    "@liwa/experimental-forge-github": "workspace:*",
    "@liwa/fs-local": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/shell-env": "workspace:*",
    "@liwa/subprocess-local": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/tool-bash": "workspace:*",
    "@liwa/tool-executor-native": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/working-directory": "workspace:*",
    "@liwa/shell": "workspace:*",
    "@liwa/sandbox-policy": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@liwa/shell": {
      "optional": true
    },
    "@liwa/shell-env": {
      "optional": true
    },
    "@liwa/tools": {
      "optional": true
    },
    "@liwa/sandbox-policy": {
      "optional": true
    }
  }
}
