{
  "name": "@liwa/experimental-inspector-profile",
  "description": "Optional Web bundle for raw Session logs and Chat node inspection",
  "version": "0.2.2-alpha.2",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/experimental/inspector-profile"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "liwa": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@liwa/experimental-inspector": "workspace:*",
    "@liwa/experimental-session-inspector": "workspace:*",
    "@liwa/experimental-client-ui-stats": "workspace:*"
  },
  "peerDependencies": {
    "@liwa/cordis": "workspace:~"
  },
  "devDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/cordis-plugin-include": "workspace:~"
  }
}
