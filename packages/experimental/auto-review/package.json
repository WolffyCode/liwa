{
  "name": "@liwa/experimental-auto-review",
  "description": "Per-tool LLM authorization review for the Liwa Auto permission preset",
  "version": "0.2.2-alpha.2",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/agent-instructions": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/permission-presets": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/working-directory": "workspace:*"
  },
  "dependencies": {
    "@liwa/util-values": "workspace:*"
  },
  "devDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/agent-instructions": "workspace:*",
    "@liwa/agent-loop": "workspace:*",
    "@liwa/agent-loop-testkit": "workspace:*",
    "@liwa/bash-sandbox": "workspace:*",
    "@liwa/compaction": "workspace:*",
    "@liwa/fs-local": "workspace:*",
    "@liwa/fs-observation-policy": "workspace:*",
    "@liwa/fs-sandbox": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/llm-deepseek": "workspace:*",
    "@liwa/llm-deepseek-api-key": "workspace:*",
    "@liwa/permission-presets": "workspace:*",
    "@liwa/ptc-runtime-node": "workspace:*",
    "@liwa/sandbox": "workspace:*",
    "@liwa/sandbox-policy": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/shell": "workspace:*",
    "@liwa/shell-env": "workspace:*",
    "@liwa/subagent": "workspace:*",
    "@liwa/subprocess-local": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/tool-bash": "workspace:*",
    "@liwa/tool-executor-native": "workspace:*",
    "@liwa/tool-executor-ptc": "workspace:*",
    "@liwa/tool-fs": "workspace:*",
    "@liwa/tool-subagent": "workspace:*",
    "@liwa/tool-testkit": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/user-approval": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/working-directory": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "liwa": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
