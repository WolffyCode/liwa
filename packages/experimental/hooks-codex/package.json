{
  "name": "@liwa/hooks-codex",
  "description": "Bridge plugin: run a Codex hooks.json hook config on the Liwa interception seams",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/experimental/hooks-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@liwa/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/hook-protocol": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/agent-loop": "workspace:*",
    "@liwa/agent-loop-testkit": "workspace:*",
    "@liwa/shell": "workspace:*",
    "@liwa/bash-local": "workspace:*",
    "@liwa/subprocess-local": "workspace:*",
    "@liwa/hook-protocol": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-persistence-jsonl": "workspace:*",
    "@liwa/tool-testkit": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/session-projection": "workspace:*",
    "@liwa/working-directory": "workspace:*"
  }
}
