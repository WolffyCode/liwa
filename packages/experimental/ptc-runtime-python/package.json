{
  "name": "@liwa/experimental-ptc-runtime-python",
  "description": "CPython subprocess implementation of the Liwa PTC execution seam",
  "version": "0.2.2-alpha.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/experimental/ptc-runtime-python"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "py/**/*.py",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/ptc-runtime": "workspace:*",
    "@liwa/timeout": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/util-values": "workspace:*",
    "@liwa/sandbox": "workspace:*",
    "@liwa/sandbox-policy": "workspace:*"
  },
  "devDependencies": {
    "@liwa/ptc-runtime": "workspace:*",
    "@liwa/timeout": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/util-values": "workspace:*",
    "@liwa/sandbox": "workspace:*",
    "@liwa/sandbox-policy": "workspace:*",
    "@liwa/sandbox-local": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/session": "workspace:*"
  },
  "dependencies": {
    "@liwa/schemastery": "workspace:~"
  },
  "publishConfig": {
    "access": "public"
  }
}
