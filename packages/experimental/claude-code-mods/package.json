{
  "name": "@liwa/experimental-claude-code-mods",
  "description": "Experimental bridge: load Claude Code mods (hooks modules) and run their hook chains on Liwa extension points",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/experimental/claude-code-mods"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./testing": {
      "types": "./lib/types/testing.d.ts",
      "default": "./lib/types/testing.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./examples/*": "./examples/*",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@liwa/util-crypto": "workspace:*",
    "@liwa/util-values": "workspace:*",
    "@liwa/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/commands": "workspace:*",
    "@liwa/fs": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/scope": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/storage-domain": "workspace:*",
    "@liwa/subprocess": "workspace:*",
    "@liwa/token-meter": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/typert-protocol": "workspace:*",
    "@liwa/user-questions": "workspace:*",
    "@liwa/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/cordis-plugin-include": "workspace:~",
    "@liwa/cordis-plugin-loader": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/agent-loop": "workspace:*",
    "@liwa/agent-loop-testkit": "workspace:*",
    "@liwa/attachment": "workspace:*",
    "@liwa/commands": "workspace:*",
    "@liwa/fs": "workspace:*",
    "@liwa/fs-local": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/scope": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/storage": "workspace:*",
    "@liwa/storage-domain": "workspace:*",
    "@liwa/storage-json": "workspace:*",
    "@liwa/subprocess": "workspace:*",
    "@liwa/subprocess-local": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/token-meter": "workspace:*",
    "@liwa/tool-executor-native": "workspace:*",
    "@liwa/tool-testkit": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/typert-protocol": "workspace:*",
    "@liwa/user-questions": "workspace:*",
    "@liwa/working-directory": "workspace:*",
    "@liwa/session-persistence-jsonl": "workspace:*"
  }
}
