{
  "name": "@liwa/tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@liwa/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@liwa/llm": "workspace:*",
    "@liwa/output-retention": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/spill": "workspace:*",
    "@liwa/subprocess": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/timeout": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/subprocess": "workspace:*",
    "@liwa/subprocess-local": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/output-retention": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/spill": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/timeout": "workspace:*",
    "@liwa/tool-executor-native": "workspace:*",
    "@liwa/tool-testkit": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/scope": "workspace:*",
    "@liwa/working-directory": "workspace:*",
    "@liwa/agent-loop-testkit": "workspace:*"
  }
}
