{
  "name": "@liwa/agent-preset",
  "description": "Declare an Agent capability composition in Cordis YAML",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/preset/agent-preset"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "skills",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/cordis-plugin-loader": "workspace:~",
    "@liwa/agent-preset-registry": "workspace:*"
  },
  "dependencies": {
    "@liwa/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/cordis-plugin-include": "workspace:~",
    "@liwa/cordis-plugin-loader": "workspace:~",
    "@liwa/agent-preset-registry": "workspace:*",
    "@liwa/compaction-tool-result-pruner": "workspace:*",
    "@liwa/skill": "workspace:*",
    "@liwa/skill-filesystem": "workspace:*",
    "@liwa/schemastery": "workspace:~"
  }
}
