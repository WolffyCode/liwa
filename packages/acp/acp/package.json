{
  "name": "@liwa/acp",
  "description": "Automation-only Agent Client Protocol server for driving Liwa agents over JSON-RPC stdio",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@liwa/brand": "workspace:*",
    "@liwa/cmdline": "workspace:*",
    "@liwa/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/agent-preset-registry": "workspace:*",
    "@liwa/attachment": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/llm": "workspace:*",
    "@liwa/mcp-client": "workspace:*",
    "@liwa/plan-mode": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-persistence": "workspace:*",
    "@liwa/token-meter": "workspace:*",
    "@liwa/user-approval": "workspace:*",
    "@liwa/user-questions": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@liwa/agent-preset-registry": {
      "optional": true
    },
    "@liwa/plan-mode": {
      "optional": true
    },
    "@liwa/token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/agent-loop": "workspace:*",
    "@liwa/agent-loop-testkit": "workspace:*",
    "@liwa/agent-preset-registry": "workspace:*",
    "@liwa/attachment": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/llm": "workspace:*",
    "@liwa/mcp-client": "workspace:*",
    "@liwa/plan-mode": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-persistence": "workspace:*",
    "@liwa/session-persistence-jsonl": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/subagent": "workspace:*",
    "@liwa/token-meter": "workspace:*",
    "@liwa/tool-testkit": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/user-approval": "workspace:*",
    "@liwa/user-questions": "workspace:*"
  }
}
