{
  "name": "@liwa/api-session-controller",
  "description": "Session Remote commands, cold reads, and live control transport",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/api/session-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-events": {
      "types": "./lib/types/remote-events.d.ts",
      "default": "./lib/types/remote-events.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "liwa": {
    "client": {
      "external": [
        "@liwa/api-gateway/client"
      ],
      "inject": [
        "@liwa/api-gateway",
        "@liwa/client-file-upload"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@liwa/brand": "workspace:*",
    "@liwa/deque": "workspace:*",
    "@liwa/timeout": "workspace:*",
    "@liwa/schemastery": "workspace:~",
    "mime-types": "^3.0.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/agent-default-model": "workspace:*",
    "@liwa/agent-preset-registry": "workspace:*",
    "@liwa/api-gateway": "workspace:*",
    "@liwa/attachment": "workspace:*",
    "@liwa/client-connection": "workspace:*",
    "@liwa/client-file-upload": "workspace:*",
    "@liwa/commands": "workspace:*",
    "@liwa/file-reference": "workspace:*",
    "@liwa/fs": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/native-command": "workspace:*",
    "@liwa/scope": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-persistence": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/session-projection-cache": "workspace:*",
    "@liwa/session-query": "workspace:*",
    "@liwa/session-title": "workspace:*",
    "@liwa/skill": "workspace:*",
    "@liwa/subagent": "workspace:*",
    "@liwa/typert-protocol": "workspace:*",
    "@liwa/typert-registry": "workspace:*",
    "@liwa/util-time": "workspace:*",
    "@liwa/util-values": "workspace:*",
    "@liwa/util-workspace-path": "workspace:*",
    "@liwa/workspace": "workspace:*",
    "@liwa/working-directory": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@liwa/session-persistence": {
      "optional": true
    },
    "@liwa/session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@liwa/api-remote-access": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/agent-default-model": "workspace:*",
    "@liwa/agent-loop": "workspace:*",
    "@liwa/agent-loop-testkit": "workspace:*",
    "@liwa/agent-preset-registry": "workspace:*",
    "@liwa/api-gateway": "workspace:*",
    "@liwa/attachment": "workspace:*",
    "@liwa/attachment-local": "workspace:*",
    "@liwa/client-connection": "workspace:*",
    "@liwa/client-file-upload": "workspace:*",
    "@liwa/client-store": "workspace:*",
    "@liwa/client-test-runtime": "workspace:*",
    "@liwa/commands": "workspace:*",
    "@liwa/file-reference": "workspace:*",
    "@liwa/fs": "workspace:*",
    "@liwa/fs-local": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/native-command": "workspace:*",
    "@liwa/permission-presets": "workspace:*",
    "@liwa/remote-mock": "workspace:*",
    "@liwa/scope": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-persistence": "workspace:*",
    "@liwa/session-persistence-jsonl": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/session-projection-cache": "workspace:*",
    "@liwa/session-query": "workspace:*",
    "@liwa/session-title": "workspace:*",
    "@liwa/skill": "workspace:*",
    "@liwa/storage": "workspace:*",
    "@liwa/storage-domain": "workspace:*",
    "@liwa/storage-json": "workspace:*",
    "@liwa/subagent": "workspace:*",
    "@liwa/typert-protocol": "workspace:*",
    "@liwa/typert-registry": "workspace:*",
    "@liwa/util-crypto": "workspace:*",
    "@liwa/util-time": "workspace:*",
    "@liwa/util-values": "workspace:*",
    "@liwa/util-workspace-path": "workspace:*",
    "@liwa/workspace": "workspace:*",
    "@types/mime-types": "^3.0.1",
    "@liwa/working-directory": "workspace:*"
  }
}
