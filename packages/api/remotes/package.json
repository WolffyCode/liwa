{
  "name": "@liwa/api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "liwa": {
    "client": {
      "inject": [
        "@liwa/api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@liwa/deque": "workspace:*",
    "@liwa/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/scope": "workspace:*"
  },
  "devDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/agent-preset-registry": "workspace:*",
    "@liwa/api-gateway": "workspace:*",
    "@liwa/api-job-controller": "workspace:*",
    "@liwa/api-session-controller": "workspace:*",
    "@liwa/api-settings-controller": "workspace:*",
    "@liwa/api-workspace-controller": "workspace:*",
    "@liwa/api-workspace-files": "workspace:*",
    "@liwa/client-connection": "workspace:*",
    "@liwa/client-file-upload": "workspace:*",
    "@liwa/commands": "workspace:*",
    "@liwa/cordis-host-runner": "workspace:*",
    "@liwa/credentials": "workspace:*",
    "@liwa/file-reference": "workspace:*",
    "@liwa/goal": "workspace:*",
    "@liwa/host-plugin-inventory": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/message-feedback": "workspace:*",
    "@liwa/permission-presets": "workspace:*",
    "@liwa/schedule": "workspace:*",
    "@liwa/scope": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-reference": "workspace:*",
    "@liwa/settings": "workspace:*",
    "@liwa/subagent": "workspace:*",
    "@liwa/typert-protocol": "workspace:*",
    "@liwa/user-approval": "workspace:*",
    "@liwa/user-questions": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "zod": "4.4.3",
    "@liwa/command-feedback": "workspace:*",
    "@liwa/api-terminal-controller": "workspace:*",
    "@liwa/plugin-manager": "workspace:*",
    "@liwa/plugin-market": "workspace:*",
    "@liwa/client-ui-plugin-manager": "workspace:*",
    "@liwa/office-to-pdf": "workspace:*",
    "@liwa/api-account-controller": "workspace:*",
    "@liwa/deepseek-account": "workspace:*",
    "@liwa/client-product-analytics": "workspace:*",
    "@liwa/client-ui-trajectory": "workspace:*"
  }
}
