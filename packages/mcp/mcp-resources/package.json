{
  "name": "@liwa/mcp-resources",
  "description": "Scoped MCP resource discovery and reading through shared model tools",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/mcp/mcp-resources"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/llm": "workspace:*",
    "@liwa/scope": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/tools": "workspace:*"
  },
  "devDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/llm": "workspace:*",
    "@liwa/ptc-runtime": "workspace:*",
    "@liwa/scope": "workspace:*",
    "@liwa/tool-executor-native": "workspace:*",
    "@liwa/tool-executor-ptc": "workspace:*",
    "@liwa/tool-testkit": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/agent": "workspace:*"
  },
  "dependencies": {
    "@liwa/util-values": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@liwa/system-prompt": {
      "optional": true
    }
  }
}
