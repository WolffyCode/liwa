{
  "name": "@liwa/llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the Liwa LLM seam (design-verification twin of liwa-llm-deepseek)",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/cordis-plugin-loader": "workspace:~",
    "@liwa/attachment": "workspace:*",
    "@liwa/authorization": "workspace:*",
    "@liwa/credentials": "workspace:*",
    "@liwa/fs": "workspace:*",
    "@liwa/launch-environment": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/timeout": "workspace:*"
  },
  "dependencies": {
    "@liwa/brand": "workspace:*",
    "@liwa/util-values": "workspace:*",
    "@liwa/schemastery": "workspace:~",
    "@earendil-works/pi-ai": "^1.3.0"
  },
  "devDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/cordis-plugin-loader": "workspace:~",
    "@liwa/agent-loop-testkit": "workspace:*",
    "@liwa/attachment": "workspace:*",
    "@liwa/authorization": "workspace:*",
    "@liwa/credentials": "workspace:*",
    "@liwa/fs": "workspace:*",
    "@liwa/http-proxy": "workspace:*",
    "@liwa/launch-environment": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/llm-deepseek": "workspace:*",
    "@liwa/llm-deepseek-api-key": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/settings": "workspace:*",
    "@liwa/timeout": "workspace:*",
    "@liwa/tool-testkit": "workspace:*",
    "@liwa/tools": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@liwa/cordis-plugin-loader": {
      "optional": true
    }
  }
}
