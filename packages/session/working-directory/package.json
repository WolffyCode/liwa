{
  "name": "@liwa/working-directory",
  "description": "Session working directories with durable changes and model context",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/session/working-directory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/fs": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/system-prompt": "workspace:*"
  },
  "devDependencies": {
    "@liwa/sandbox-policy": "workspace:*",
    "@liwa/user-approval": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/fs": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/agent-loop-testkit": "workspace:*",
    "@liwa/fs-local": "workspace:*",
    "@liwa/tool-testkit": "workspace:*",
    "@liwa/tool-working-directory": "workspace:*",
    "@liwa/tools": "workspace:*"
  },
  "dependencies": {
    "@liwa/schemastery": "workspace:~",
    "zod": "^4.4.3"
  }
}
