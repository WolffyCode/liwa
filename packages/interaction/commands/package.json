{
  "name": "@liwa/commands",
  "description": "Plugin-owned human command registry for Liwa UIs",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/interaction/commands"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./brand": {
      "types": "./lib/types/brand.d.ts",
      "default": "./lib/types/brand.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/attachment": "workspace:*",
    "@liwa/brand": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/scope": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/typert-protocol": "workspace:*",
    "@liwa/cordis": "workspace:~"
  },
  "dependencies": {
    "@liwa/util-crypto": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/attachment": "workspace:*",
    "@liwa/brand": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/scope": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/typert-protocol": "workspace:*",
    "@liwa/cordis": "workspace:~"
  }
}
