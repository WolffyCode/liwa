{
  "name": "@liwa/terminal-bash",
  "description": "Persistent shell PTY backend over the Liwa subprocess terminal primitive",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/terminal": "workspace:*",
    "@liwa/sandbox": "workspace:*",
    "@liwa/sandbox-policy": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/subprocess": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/working-directory": "workspace:*"
  },
  "dependencies": {
    "@liwa/lazy-require": "workspace:*",
    "@liwa/pwsh-local": "workspace:*",
    "@liwa/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/agent-loop-testkit": "workspace:*",
    "@liwa/terminal": "workspace:*",
    "@liwa/sandbox": "workspace:*",
    "@liwa/sandbox-policy": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/subprocess": "workspace:*",
    "@liwa/subprocess-local": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/working-directory": "workspace:*"
  }
}
