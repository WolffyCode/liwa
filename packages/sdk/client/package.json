{
  "name": "@liwa/sdk-client",
  "description": "TypeScript client SDK for driving a Liwa runtime subprocess over stdio JSON-RPC: the Liwa high-level turns API and the lower-level LiwaClient",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/sdk/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@liwa/cli": "workspace:*"
  },
  "peerDependencies": {
    "@liwa/llm": "workspace:*",
    "@liwa/sdk-protocol": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/cordis": "workspace:~"
  },
  "devDependencies": {
    "@liwa/llm": "workspace:*",
    "@liwa/sdk-protocol": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/experimental-translator": "workspace:*"
  }
}
