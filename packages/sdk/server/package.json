{
  "name": "@liwa/sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Liwa SDK clients",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@liwa/brand": "workspace:*",
    "@liwa/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/attachment": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/llm-deepseek-api-key": "workspace:*",
    "@liwa/schedule": "workspace:*",
    "@liwa/scope": "workspace:*",
    "@liwa/sdk-protocol": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/subagent": "workspace:*",
    "@liwa/user-approval": "workspace:*",
    "@liwa/user-questions": "workspace:*",
    "@liwa/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/cordis-plugin-loader": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/agent-loop": "workspace:*",
    "@liwa/agent-loop-testkit": "workspace:*",
    "@liwa/attachment": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/llm-deepseek-api-key": "workspace:*",
    "@liwa/schedule": "workspace:*",
    "@liwa/scope": "workspace:*",
    "@liwa/sdk-protocol": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-persistence-jsonl": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/subagent": "workspace:*",
    "@liwa/user-approval": "workspace:*",
    "@liwa/user-questions": "workspace:*",
    "@liwa/working-directory": "workspace:*"
  }
}
