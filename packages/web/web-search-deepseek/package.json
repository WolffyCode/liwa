{
  "name": "@liwa/web-search-deepseek",
  "description": "DeepSeek-backed search provider (native web_search via the Anthropic-compatible API) for the Liwa web capability seam (ctx.web)",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/web/web-search-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/credentials": "workspace:*",
    "@liwa/deepseek-account": "workspace:*",
    "@liwa/launch-environment": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/web": "workspace:*",
    "@liwa/cordis": "workspace:~"
  },
  "dependencies": {
    "@liwa/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/credentials": "workspace:*",
    "@liwa/credentials-local": "workspace:*",
    "@liwa/deepseek-account": "workspace:*",
    "@liwa/launch-environment": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/web": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/http-proxy": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@liwa/deepseek-account": {
      "optional": true
    }
  }
}
