{
  "name": "@liwa/web",
  "description": "Abstract web access capability seam (ctx.web) for the Liwa — search/fetch provider registry, registration-order-independent selection, request/result vocabulary, and the WebError taxonomy",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/web/web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/llm": "workspace:*",
    "@liwa/cordis": "workspace:~"
  },
  "dependencies": {
    "@liwa/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@liwa/llm": "workspace:*",
    "@liwa/cordis": "workspace:~"
  }
}
