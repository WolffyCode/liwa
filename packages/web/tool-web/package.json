{
  "name": "@liwa/tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the Liwa web capability seam (ctx.web)",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/llm": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/web": "workspace:*"
  },
  "dependencies": {
    "@liwa/output-retention": "workspace:*",
    "@liwa/util-values": "workspace:*",
    "@liwa/schemastery": "workspace:~",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/spill-local": "workspace:*",
    "@liwa/spill-policy": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/tool-call-timeout-policy": "workspace:*",
    "@liwa/tool-executor-native": "workspace:*",
    "@liwa/tool-testkit": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/web": "workspace:*",
    "@liwa/web-fetch-http": "workspace:*",
    "@liwa/web-search-exa": "workspace:*",
    "@types/turndown": "^5.0.6",
    "@liwa/scope": "workspace:*",
    "@liwa/token-meter": "workspace:*"
  }
}
