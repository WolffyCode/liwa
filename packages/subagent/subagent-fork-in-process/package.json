{
  "name": "@liwa/subagent-fork-in-process",
  "description": "In-process fork subagent backend: runs a child agent seeded with a prefix of the parent's log",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/subagent/subagent-fork-in-process"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/subagent": "workspace:*",
    "@liwa/cordis": "workspace:~"
  },
  "dependencies": {
    "@liwa/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@liwa/cordis-plugin-loader": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/agent-loop": "workspace:*",
    "@liwa/agent-loop-testkit": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/subagent": "workspace:*",
    "@liwa/subagent-spawn-in-process": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/session-projection": "workspace:*"
  }
}
