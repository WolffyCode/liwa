{
  "name": "@liwa/agent-instructions",
  "description": "Workspace context loader for AGENTS.md/CLAUDE.md instruction files",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/context/agent-instructions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/fs": "workspace:*",
    "@liwa/home-paths": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/working-directory": "workspace:*"
  },
  "dependencies": {
    "@liwa/util-values": "workspace:*",
    "@liwa/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/cordis-plugin-loader": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/agent-loop": "workspace:*",
    "@liwa/agent-loop-testkit": "workspace:*",
    "@liwa/fs": "workspace:*",
    "@liwa/fs-local": "workspace:*",
    "@liwa/home-paths": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/llm-deepseek": "workspace:*",
    "@liwa/llm-deepseek-api-key": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/tool-executor-native": "workspace:*",
    "@liwa/tool-fs": "workspace:*",
    "@liwa/tool-testkit": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/working-directory": "workspace:*"
  }
}
