    "@liwa/llm": "workspace:*",
    "@liwa/loader-smoke": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-checkpoint-policy": "workspace:*",
    "@liwa/session-persistence-jsonl": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/subprocess-local": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/tool-testkit": "workspace:*",
