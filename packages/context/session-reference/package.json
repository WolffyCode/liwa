{
  "name": "@liwa/session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/context/session-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@liwa/brand": "workspace:*",
    "@liwa/util-values": "workspace:*",
    "@liwa/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/compaction": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/output-retention": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/session-projection-cache": "workspace:*",
    "@liwa/session-query": "workspace:*",
    "@liwa/session-title": "workspace:*",
    "@liwa/spill": "workspace:*",
    "@liwa/subagent": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@liwa/spill": {
      "optional": true
    },
    "@liwa/session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/cordis-plugin-include": "workspace:~",
    "@liwa/cordis-plugin-loader": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/compaction": "workspace:*",
    "@liwa/fs-local": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/output-retention": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/session-projection-cache": "workspace:*",
    "@liwa/session-query": "workspace:*",
    "@liwa/session-query-sqlite": "workspace:*",
    "@liwa/session-title": "workspace:*",
    "@liwa/spill": "workspace:*",
    "@liwa/subagent": "workspace:*",
    "@liwa/spill-local": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/tool-executor-native": "workspace:*",
    "@liwa/tool-fs": "workspace:*",
    "@liwa/tool-testkit": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/typert-protocol": "workspace:*",
    "@liwa/working-directory": "workspace:*"
  }
}
