{
  "name": "@liwa/tool-skill",
  "description": "Model-facing skill loading tool for Liwa",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/skill/tool-skill"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/skill": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/working-directory": "workspace:*"
  },
  "dependencies": {
    "@liwa/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/agent-loop-testkit": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/scope": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/skill": "workspace:*",
    "@liwa/skill-filesystem": "workspace:*",
    "@liwa/tool-executor-native": "workspace:*",
    "@liwa/tool-testkit": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/working-directory": "workspace:*"
  }
}
