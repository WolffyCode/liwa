{
  "name": "@liwa/cordis-host-runner",
  "description": "Dynamic package definition registry, host-half sandbox lifecycle, and invoke handler table for model-mounted dual-half packages",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/extensions/cordis-host-runner"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@liwa/util-values": "workspace:*",
    "@liwa/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/brand": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/scope": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/cordis-plugin-timer": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/api-gateway": "workspace:*",
    "@liwa/api-remote-access": "workspace:*",
    "@liwa/brand": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/scope": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/tool-executor-native": "workspace:*",
    "@liwa/tool-testkit": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/typert-protocol": "workspace:*"
  }
}
