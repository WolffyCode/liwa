{
  "name": "@liwa/schedule",
  "description": "Host-wide durable reminders with shared management and original-Session delivery",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/schedule/schedule"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/api-session-controller": "workspace:*",
    "@liwa/brand": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-persistence": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/storage-domain": "workspace:*",
    "@liwa/subagent": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/typert-protocol": "workspace:*",
    "@liwa/util-time": "workspace:*",
    "@liwa/workspace": "workspace:*",
    "@liwa/cordis": "workspace:~"
  },
  "dependencies": {
    "@liwa/schemastery": "workspace:~",
    "@js-temporal/polyfill": "0.5.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@liwa/cordis-plugin-loader": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/agent-loop": "workspace:*",
    "@liwa/agent-loop-testkit": "workspace:*",
    "@liwa/api-session-controller": "workspace:*",
    "@liwa/brand": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-persistence": "workspace:*",
    "@liwa/session-persistence-jsonl": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/storage": "workspace:*",
    "@liwa/storage-domain": "workspace:*",
    "@liwa/storage-json": "workspace:*",
    "@liwa/subagent": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/tool-executor-native": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/typert-protocol": "workspace:*",
    "@liwa/util-time": "workspace:*",
    "@liwa/workspace": "workspace:*",
    "@liwa/cordis": "workspace:~"
  }
}
