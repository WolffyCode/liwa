{
  "name": "@liwa/client-ui-layout",
  "description": "Shell plugin: three-column AppFrame with drag handles, ctx.layout viewing-state service (navigation + panels)",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/client/ui-layout"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "liwa": {
    "client": {
      "inject": [
        "@liwa/client-locale",
        "@liwa/client-ui-renderer",
        "@liwa/client-ui-session",
        "@liwa/client-ui-theme",
        "@liwa/client-shortcuts"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@liwa/cordis": "workspace:~"
  },
  "devDependencies": {
    "@liwa/brand": "workspace:*",
    "@liwa/client-locale": "workspace:*",
    "@liwa/client-store": "workspace:*",
    "@liwa/client-ui-renderer": "workspace:*",
    "@liwa/client-ui-session": "workspace:*",
    "@liwa/client-ui-slots": "workspace:*",
    "@liwa/client-ui-theme": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "react": "^18.2.0",
    "@liwa/client-shortcuts": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
