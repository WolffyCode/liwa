{
  "name": "@liwa/client-ui-tool",
  "description": "Client Tool call-tree renderer and keyed per-tool presentation slot",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/client/ui-tool"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "liwa": {
    "client": {
      "inject": [
        "@liwa/api-workspace-controller",
        "@liwa/client-connection",
        "@liwa/client-locale",
        "@liwa/client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@liwa/cordis": "workspace:~"
  },
  "devDependencies": {
    "@liwa/spill-policy": "workspace:*",
    "@liwa/agent": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/tool-testkit": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/tool-executor-native": "workspace:*",
    "@liwa/tool-executor-ptc": "workspace:*",
    "@liwa/tool-jobs": "workspace:*",
    "@liwa/tool-session-query": "workspace:*",
    "@liwa/tool-terminal": "workspace:*",
    "@liwa/spill": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/api-remotes": "workspace:*",
    "@liwa/client-connection": "workspace:*",
    "@liwa/client-locale": "workspace:*",
    "@liwa/client-test-runtime": "workspace:*",
    "@liwa/client-ui-conversation": "workspace:*",
    "@liwa/client-ui-primitives": "workspace:*",
    "@liwa/client-ui-slots": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@liwa/api-workspace-controller": "workspace:*",
    "@liwa/client-ui-chat": "workspace:*",
    "@liwa/client-ui-renderer": "workspace:*",
    "@liwa/client-ui-session": "workspace:*",
    "@liwa/util-values": "workspace:*",
    "@liwa/util-workspace-path": "workspace:*",
    "@liwa/attachment": "workspace:*",
    "clsx": "^2.0.0",
    "@liwa/ptc-runtime": "workspace:*",
    "@liwa/token-meter": "workspace:*",
    "@liwa/user-questions": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
