{
  "name": "@liwa/client-ui-trajectory",
  "description": "Trajectory event ledger and timing overview with live tool-result inspection",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/client/ui-trajectory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    }
  },
  "liwa": {
    "client": {
      "inject": [
        "@liwa/api-session-controller",
        "@liwa/client-locale",
        "@liwa/client-ui-conversation",
        "@liwa/client-ui-renderer",
        "@liwa/client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@liwa/cordis": "workspace:~"
  },
  "devDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/client-locale": "workspace:*",
    "@liwa/client-test-runtime": "workspace:*",
    "@liwa/client-ui-primitives": "workspace:*",
    "@liwa/client-ui-conversation": "workspace:*",
    "@liwa/tool-executor-ptc": "workspace:*",
    "@liwa/util-values": "workspace:*",
    "@liwa/client-ui-slots": "workspace:*",
    "@liwa/compaction": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@liwa/client-store": "workspace:*",
    "@liwa/client-ui-chat": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/api-session-controller": "workspace:*",
    "@liwa/client-ui-renderer": "workspace:*",
    "@liwa/client-ui-session": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/attachment": "workspace:*",
    "@tanstack/react-virtual": "3.14.10",
    "diff": "^9.0.0",
    "@liwa/api-gateway": "workspace:*",
    "@liwa/tools": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "@liwa/typert-protocol": "workspace:*",
    "zod": "4.4.3",
    "@liwa/schemastery": "workspace:~"
  }
}
