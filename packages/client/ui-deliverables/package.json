{
  "name": "@liwa/client-ui-deliverables",
  "description": "Changed-files card with per-file comparison tabs, delivery cards, and clickable final-response file references for Web",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/client/ui-deliverables"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "liwa": {
    "client": {
      "inject": [
        "@liwa/api-remotes",
        "@liwa/client-connection",
        "@liwa/client-locale",
        "@liwa/client-ui-chat",
        "@liwa/client-ui-conversation",
        "@liwa/client-ui-renderer",
        "@liwa/client-ui-sidebar-right",
        "@liwa/client-ui-tool",
        "@liwa/client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@liwa/cordis": "workspace:~"
  },
  "devDependencies": {
    "@liwa/api-remotes": "workspace:*",
    "@liwa/client-connection": "workspace:*",
    "@liwa/client-locale": "workspace:*",
    "@liwa/client-store": "workspace:*",
    "@liwa/client-test-runtime": "workspace:*",
    "@liwa/client-ui-chat": "workspace:*",
    "@liwa/client-ui-conversation": "workspace:*",
    "@liwa/client-ui-dockkit": "workspace:*",
    "@liwa/client-ui-renderer": "workspace:*",
    "@liwa/client-ui-sidebar-right": "workspace:*",
    "@liwa/client-ui-slots": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "react": "^18.2.0",
    "@liwa/client-ui-primitives": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/session-query": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/client-ui-tool": "workspace:*",
    "@liwa/tool-present": "workspace:*",
    "@liwa/workspace-changes": "workspace:*",
    "@liwa/api-session-controller": "workspace:*",
    "@liwa/util-values": "workspace:*",
    "@liwa/util-workspace-path": "workspace:*",
    "@liwa/api-workspace-files": "workspace:*",
    "@liwa/fs": "workspace:*",
    "@liwa/fs-local": "workspace:*",
    "@liwa/agent": "workspace:*",
    "@liwa/sandbox-policy": "workspace:*",
    "@liwa/client-ui-settings": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@liwa/typert-protocol": "workspace:*"
  }
}
