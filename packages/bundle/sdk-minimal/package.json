{
  "name": "@liwa/sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "liwa": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@liwa/cordis-plugin-timer": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/agent-loop": "workspace:*",
    "@liwa/attachment-local": "workspace:*",
    "@liwa/compaction-basic": "workspace:*",
    "@liwa/compaction-image-offload": "workspace:*",
    "@liwa/deepseek-llm-api-extensions": "workspace:*",
    "@liwa/jobs-local": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/llm-deepseek-api-key": "workspace:*",
    "@liwa/llm-retry": "workspace:*",
    "@liwa/mcp-resources": "workspace:*",
    "@liwa/plugin-package-inventory-deepseek": "workspace:*",
    "@liwa/sandbox-local": "workspace:*",
    "@liwa/sandbox-policy": "workspace:*",
    "@liwa/sdk-app": "workspace:*",
    "@liwa/sdk-jsonrpc-server": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-checkpoint-policy": "workspace:*",
    "@liwa/session-log-deepseek": "workspace:*",
    "@liwa/session-persistence-jsonl": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/session-title": "workspace:*",
    "@liwa/subprocess-local": "workspace:*",
    "@liwa/system-prompt": "workspace:*",
    "@liwa/terminal": "workspace:*",
    "@liwa/terminal-bash": "workspace:*",
    "@liwa/token-meter": "workspace:*",
    "@liwa/tool-bash-persistent": "workspace:*",
    "@liwa/tool-executor-native": "workspace:*",
    "@liwa/tool-fs": "workspace:*",
    "@liwa/tool-pwsh-persistent": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/working-directory": "workspace:*",
    "@liwa/tool-working-directory": "workspace:*",
    "@liwa/fs-local": "workspace:*"
  },
  "peerDependencies": {
    "@liwa/cordis": "workspace:~"
  },
  "devDependencies": {
    "@liwa/cordis": "workspace:~"
  }
}
