{
  "name": "@liwa/brain-cli",
  "description": "The liwa brain command bundle: list, probe, and try the agent CLI providers of ctx.brains over liwa-base",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/bundle/brain-cli"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "liwa": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@liwa/brain": "workspace:*",
    "@liwa/brain-acp": "workspace:*",
    "@liwa/brain-claude-code": "workspace:*",
    "@liwa/brain-deepseek": "workspace:*",
    "@liwa/cmdline": "workspace:*",
    "@liwa/schemastery": "workspace:~",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/cordis-plugin-loader": "workspace:~"
  },
  "devDependencies": {
    "@liwa/brain-testkit": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/cordis-plugin-loader": "workspace:~",
    "@liwa/subprocess": "workspace:*",
    "@liwa/subprocess-local": "workspace:*"
  }
}
