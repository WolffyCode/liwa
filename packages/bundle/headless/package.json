{
  "name": "@liwa/headless",
  "description": "The liwa one-shot bundle: a direct core Agent/Session runner over liwa-base with no Host, HTTP, or browser layer",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/json-stream-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "liwa": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@liwa/brain": "workspace:*",
    "@liwa/brain-acp": "workspace:*",
    "@liwa/brain-deepseek": "workspace:*",
    "@liwa/brand": "workspace:*",
    "@liwa/cmdline": "workspace:*",
    "@liwa/schemastery": "workspace:~",
    "@liwa/util-values": "workspace:*",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/cordis-plugin-loader": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/agent-default-model": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-query": "workspace:*",
    "@liwa/fs": "workspace:*",
    "@liwa/permission-presets": "workspace:*",
    "@liwa/sandbox-policy": "workspace:*",
    "@liwa/subagent": "workspace:*",
    "@liwa/user-approval": "workspace:*"
  },
  "devDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/cordis-plugin-loader": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/agent-default-model": "workspace:*",
    "@liwa/agent-loop": "workspace:*",
    "@liwa/agent-loop-testkit": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/session-query": "workspace:*",
    "@liwa/fs": "workspace:*",
    "@liwa/permission-presets": "workspace:*",
    "@liwa/sandbox-policy": "workspace:*",
    "@liwa/subagent": "workspace:*",
    "@liwa/user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@liwa/permission-presets": {
      "optional": true
    },
    "@liwa/sandbox-policy": {
      "optional": true
    },
    "@liwa/subagent": {
      "optional": true
    }
  }
}
