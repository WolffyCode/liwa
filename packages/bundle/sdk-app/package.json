{
  "name": "@liwa/sdk-app",
  "description": "The liwa SDK profile bundle: stdio JSON-RPC serving and process lifecycle over liwa-base",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/bundle/sdk-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "liwa": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@liwa/cmdline": "workspace:*",
    "@liwa/sdk-jsonrpc-server": "workspace:*",
    "@liwa/schemastery": "workspace:~",
    "commander": "^15.0.0",
    "@liwa/skill-office": "workspace:*",
    "@liwa/tool-workspace-dependencies": "workspace:*",
    "@liwa/client-connection": "workspace:*",
    "@liwa/client-file-upload": "workspace:*",
    "@liwa/workspace": "workspace:*",
    "@liwa/schedule": "workspace:*",
    "@liwa/time-context": "workspace:*",
    "@liwa/tool-schedule": "workspace:*",
    "@liwa/tool-ask-user": "workspace:*",
    "@liwa/tool-present": "workspace:*",
    "@liwa/file-reference-local": "workspace:*",
    "@liwa/deliverable-file-references": "workspace:*"
  },
  "peerDependencies": {
    "@liwa/cordis": "workspace:~"
  },
  "devDependencies": {
    "@liwa/cordis-plugin-include": "workspace:~",
    "@liwa/cordis": "workspace:~"
  }
}
