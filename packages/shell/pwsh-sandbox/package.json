{
  "name": "@liwa/pwsh-sandbox",
  "description": "Sandbox-consuming implementation of the Liwa PowerShell executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/shell/pwsh-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/shell": "workspace:*",
    "@liwa/pwsh-local": "workspace:*",
    "@liwa/sandbox": "workspace:*",
    "@liwa/sandbox-policy": "workspace:*",
    "@liwa/cordis": "workspace:~"
  },
  "devDependencies": {
    "@liwa/shell": "workspace:*",
    "@liwa/pwsh-local": "workspace:*",
    "@liwa/sandbox": "workspace:*",
    "@liwa/sandbox-local": "workspace:*",
    "@liwa/sandbox-policy": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/subprocess-local": "workspace:*",
    "@liwa/cordis": "workspace:~"
  }
}
