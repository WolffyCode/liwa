{
  "name": "@liwa/credentials-local",
  "description": "File-backed credentials provider ($LIWA_HOME/.env under the live process environment) for Liwa",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/credentials/credentials-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/atomic-write": "workspace:*",
    "@liwa/credentials": "workspace:*",
    "@liwa/launch-environment": "workspace:*",
    "@liwa/home-paths": "workspace:*",
    "@liwa/cordis": "workspace:~"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "@liwa/schemastery": "workspace:~",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@liwa/atomic-write": "workspace:*",
    "@liwa/credentials": "workspace:*",
    "@liwa/launch-environment": "workspace:*",
    "@liwa/home-paths": "workspace:*",
    "@liwa/cordis": "workspace:~"
  }
}
