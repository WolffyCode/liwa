{
  "name": "@liwa/brain-deepseek",
  "description": "The deepseek brain provider: Liwa's own agent as a per-session `liwa --profile deepseek` CLI process, driven over ACP with the _liwa extension and registered into ctx.brains",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/brain/brain-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@liwa/brain": "workspace:*",
    "@liwa/brain-acp": "workspace:*",
    "@liwa/brain-shared": "workspace:*",
    "@liwa/credentials": "workspace:*",
    "@liwa/deepseek-app": "workspace:*",
    "@liwa/launch-environment": "workspace:*",
    "@liwa/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@liwa/app-boot": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/subprocess": "workspace:*"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@liwa/app-boot": "workspace:*",
    "@liwa/brain-testkit": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/subprocess": "workspace:*",
    "@liwa/subprocess-local": "workspace:*"
  }
}
