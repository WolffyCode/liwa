{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    // src/paseo/ is upstream Paseo source kept as copied; Paseo compiles it without these two
    // checks, so the package matches the upstream options instead of rewriting the copies.
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../../../vendor/cosmokit"
    },
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../../subprocess/subprocess"
    }
  ]
}
