{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "tsBuildInfoFile": "lib/tsconfig.tsbuildinfo"
  },
  // Liwa's own modules compile under the repository's full strictness; the copied Paseo
  // sources under src/paseo/ are a separate project with upstream compiler options.
  "include": [
    "src"
  ],
  "exclude": [
    "src/paseo"
  ],
  "references": [
    {
      "path": "./tsconfig.paseo.json"
    },
    {
      "path": "../../../vendor/cosmokit"
    },
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../brain"
    },
    {
      "path": "../../subprocess/subprocess"
    },
    {
      "path": "../../util/values"
    }
  ]
}
