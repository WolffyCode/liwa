{
  "name": "@liwa/brain",
  "description": "Brain-provider capability seam (ctx.brains): the agent CLI contract, provider registration, and wrapped sessions with usage, process, and child-agent records",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/brain/brain"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@liwa/brand": "workspace:*",
    "@liwa/schemastery": "workspace:~",
    "@liwa/util-values": "workspace:*",
    "js-yaml": "^4.3.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/subprocess": "workspace:*"
  },
  "devDependencies": {
    "@liwa/brain-testkit": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/subprocess": "workspace:*",
    "@liwa/subprocess-local": "workspace:*",
    "@types/js-yaml": "^4.0.9"
  }
}
