{
  "name": "@liwa/brain-claude-code",
  "description": "Claude Code CLI brain provider with isolated member configuration, Paseo-style plaintext env per instance, managed SDK processes, structured approvals and cumulative usage accounting",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/brain/brain-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@liwa/brain": "workspace:*",
    "@liwa/brain-shared": "workspace:*",
    "lru-cache": "11.5.1",
    "zod": "4.4.3",
    "@liwa/brand": "workspace:*",
    "@liwa/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/subprocess": "workspace:*"
  },
  "devDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/brain-testkit": "workspace:*",
    "@liwa/subprocess": "workspace:*"
  }
}
