{
  "name": "@liwa/minds",
  "description": "minds plugin scaffold with copied Paseo agent code and explicit injection seams; business wiring is deferred to C\u2013G",
  "version": "0.2.2-alpha.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./paseo/*": {
      "types": "./lib/types/paseo/*.d.ts",
      "default": "./lib/types/paseo/*.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/brain/minds"
  },
  "dependencies": {
    "@liwa/brain-shared": "workspace:*",
    "@liwa/util-values": "workspace:*",
    "@liwa/schemastery": "workspace:~",
    "zod": "4.4.3",
    "p-limit": "7.3.3"
  },
  "peerDependencies": {
    "@liwa/cordis": "workspace:~"
  },
  "devDependencies": {
    "@liwa/cordis": "workspace:~"
  },
  "publishConfig": {
    "access": "public"
  }
}
