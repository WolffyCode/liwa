{
  "name": "@liwa/workspace-changes",
  "description": "Per-turn workspace file changes recorded from git working-tree snapshots and whole-file captures, with per-file comparisons, for Liwa",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/deliverables/workspace-changes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@liwa/schemastery": "workspace:~",
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/subprocess": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/fs": "workspace:*"
  },
  "devDependencies": {
    "@liwa/cordis": "workspace:~",
    "@liwa/cordis-plugin-include": "workspace:~",
    "@liwa/cordis-plugin-loader": "workspace:~",
    "@liwa/agent": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/subprocess": "workspace:*",
    "@liwa/subprocess-local": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/fs": "workspace:*",
    "@liwa/fs-local": "workspace:*",
    "@liwa/agent-loop-testkit": "workspace:*",
    "@liwa/agent-loop": "workspace:*",
    "@liwa/working-directory": "workspace:*",
    "@liwa/tool-fs": "workspace:*",
    "@liwa/tool-str-replace-editor": "workspace:*"
  }
}
