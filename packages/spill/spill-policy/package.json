{
  "name": "@liwa/spill-policy",
  "description": "Token-budgeted tool-result retention with recoverable text and image paths",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffyCode/liwa.git",
    "directory": "packages/spill/spill-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./notice": {
      "types": "./lib/types/notice.d.ts",
      "default": "./lib/types/notice.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liwa/llm": "workspace:*",
    "@liwa/output-retention": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/spill": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/attachment": "workspace:*",
    "@liwa/fs": "workspace:*",
    "@liwa/token-meter": "workspace:*"
  },
  "dependencies": {
    "@liwa/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@liwa/agent": "workspace:*",
    "@liwa/ptc-runtime-node": "workspace:*",
    "@liwa/llm": "workspace:*",
    "@liwa/output-retention": "workspace:*",
    "@liwa/session": "workspace:*",
    "@liwa/spill": "workspace:*",
    "@liwa/tool-testkit": "workspace:*",
    "@liwa/tools": "workspace:*",
    "@liwa/cordis": "workspace:~",
    "@liwa/fs-local": "workspace:*",
    "@liwa/subprocess-local": "workspace:*",
    "@liwa/sandbox-local": "workspace:*",
    "@liwa/sandbox-policy": "workspace:*",
    "@liwa/session-projection": "workspace:*",
    "@liwa/attachment": "workspace:*",
    "@liwa/fs": "workspace:*",
    "@liwa/token-meter": "workspace:*",
    "@liwa/mcp-client": "workspace:*",
    "@liwa/spill-local": "workspace:*",
    "@liwa/llm-deepseek": "workspace:*",
    "@liwa/ptc-runtime": "workspace:*",
    "@liwa/attachment-local": "workspace:*",
    "@liwa/tool-executor-native": "workspace:*",
    "@liwa/tool-executor-ptc": "workspace:*",
    "@liwa/tool-fs": "workspace:*",
    "sharp": "0.35.5",
    "@liwa/agent-loop-testkit": "workspace:*"
  }
